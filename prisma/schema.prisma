generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // A sintaxe clássica e perfeita está de volta!
}

model Card {
  id            String            @id @default(uuid())
  id_oficial    String            @unique
  id_global     String?           // O nosso Fio Invisível
  numero        String
  raridade      String
  colecao       String
  criado_em     DateTime          @default(now())
  atualizado_em DateTime          @updatedAt

  traducoes     CardTranslation[]
}

model CardTranslation {
  id            String   @id @default(uuid())
  card_id       String
  language      String
  nome          String
  descricao     String
  url_imagem    String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  card          Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([card_id, language])
}

model CartaOnePiece {
  id_oficial  String   @id // Ex: OP01-001
  nome        String
  colecao     String   // Ex: Romance Dawn
  raridade    String   // Ex: L, SR, SEC, C, UC
  tipo        String   // Leader, Character, Event, Stage
  cores       String   // Red, Green, Blue... (Pode ter mais de uma)
  atributo    String?  // Strike, Slash, Ranged, Special, Wisdom
  
  // Status Numéricos
  custo       Int?     // Leaders não têm custo
  power       Int?     // Events e Stages não têm power
  counter     Int?     // Apenas Characters têm counter (ex: +1000, +2000)
  vida        Int?     // Apenas Leaders têm Life (ex: 4, 5)
  
  // Textos e Regras
  efeito      String?  @db.Text
  trigger     String?  @db.Text
  
  // Imagens
  url_imagem  String?
}