generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // A sintaxe clássica e perfeita está de volta!
}

model Card {
  id            String            @id @default(uuid())
  id_oficial    String            @unique
  id_global     String?           // O nosso Fio Invisível
  numero        String
  raridade      String
  colecao       String
  criado_em     DateTime          @default(now())
  atualizado_em DateTime          @updatedAt

  traducoes     CardTranslation[]
}

model CardTranslation {
  id            String   @id @default(uuid())
  card_id       String
  language      String
  nome          String
  descricao     String
  url_imagem    String
  criado_em     DateTime @default(now())
  atualizado_em DateTime @updatedAt

  card          Card     @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@unique([card_id, language])
}

model CartaOnePiece {
  id_unico    String   @id // Ex: OP01-001-EN ou OP01-001-JP
  id_oficial  String   // Ex: OP01-001
  idioma      String   // Ex: English ou Japanese
  
  nome        String
  colecao     String
  raridade    String
  tipo        String
  cores       String
  atributo    String?
  
  custo       Int?
  power       Int?
  counter     Int?
  vida        Int?
  
  efeito      String?  @db.Text
  trigger     String?  @db.Text
  url_imagem  String?
}